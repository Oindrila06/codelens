# --- GitHub App ---
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=change-me
# Either paste the PEM with literal \n sequences, or point to the file:
GITHUB_PRIVATE_KEY_PATH=./secrets/codelens.private-key.pem
# GITHUB_PRIVATE_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=4096
# Optional: USD per million tokens, used for the cost numbers in reviews and evals
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0

# --- Runtime ---
DATA_DIR=./data
# inline = run reviews inside the API process (easiest for development)
# redis  = enqueue to an RQ worker (recommended for deployment)
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0

# --- Retrieval / analysis ---
# hash = no model download, deterministic; sentence-transformers = better semantic search
EMBEDDINGS_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMGREP_CONFIG=p/python
CONTEXT_TOKEN_BUDGET=6000
MAX_PR_FILES=25

# --- Optional fine-tuned triage model (see finetune/) ---
# TRIAGE_MODEL_DIR=./models/triage-lora
# TRIAGE_THRESHOLD=0.4
